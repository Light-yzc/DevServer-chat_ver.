# Copy to var/config/runtime.env; do not commit actual values or secrets.
# Used by scripts/start-stack.mjs and the user systemd service when present.
# Optional: TIPS_CODEX_BIN must point to a trusted, installed Codex executable.
TIPS_CODEX_BIN=/home/your-user/.local/bin/codex
# HTTP_PROXY=http://127.0.0.1:28888
# HTTPS_PROXY=http://127.0.0.1:28888
# ALL_PROXY=socks5h://127.0.0.1:28888
# TIPS_SUBAGENT_MAX=2
# TIPS_CONTROLLER_TIMEOUT_SECONDS=2400
