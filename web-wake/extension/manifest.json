{
  "manifest_version": 3,
  "name": "DevSpace Web Wake (prototype)",
  "version": "0.1.6",
  "description": "Route Tips wake notifications to manually named, claimed ChatGPT Web tabs.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://regen.centralus.cloudapp.azure.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html",
  "action": {"default_title": "DevSpace Web Wake", "default_popup": "options.html"}
}
