{
  "name": "devspace-tips-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Self-hosted DevSpace MCP 1.0.8 with Tips research dashboard, bidirectional agent mailbox and Codex App Server subagents",
  "engines": {"node": ">=22.19 <27"},
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "security:unify": "node scripts/unify-security.mjs",
    "admin:key": "node scripts/set-admin-key.mjs",
    "web-wake:key": "node scripts/set-web-wake-token.mjs",
    "skills:install": "node scripts/install-skills.mjs",
